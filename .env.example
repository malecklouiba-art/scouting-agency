# PostgreSQL — Supabase Dashboard > Connect. Utiliser un rôle "prisma" dédié
# (bypassrls, voir https://supabase.com/docs/guides/database/prisma), pas le
# rôle postgres par défaut.
# DATABASE_URL = pooler en mode transaction (port 6543) — utilisé par l'app.
DATABASE_URL="postgresql://prisma.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = pooler en mode session (port 5432) — utilisé par la CLI Prisma
# (migrate, studio).
DIRECT_URL="postgresql://prisma.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres"

# Supabase Auth — Settings > API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
