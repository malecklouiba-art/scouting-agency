# PostgreSQL — pointe vers votre projet Supabase en production
# (Settings > Database > Connection string > URI dans le dashboard Supabase),
# ou vers un Postgres local en développement.
DATABASE_URL="postgresql://user:password@localhost:5432/scoutpro_dev"

# Supabase Auth — Settings > API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
