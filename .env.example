# PostgreSQL — Supabase Dashboard > Connect > Transaction pooler. Rôle
# "prisma" dédié (bypassrls), pas le rôle postgres par défaut — voir
# https://supabase.com/docs/guides/database/prisma.
#
# Le pooler Supavisor (aws-0-[region].pooler.supabase.com:6543) est
# obligatoire en production : la connexion directe (db.[project-ref].
# supabase.co) est IPv6 uniquement par défaut et injoignable depuis les
# fonctions serverless de Vercel (IPv4 uniquement) sans l'add-on payant.
# ?pgbouncer=true désactive les prepared statements, requis en mode
# transaction (port 6543).
DATABASE_URL="postgresql://prisma.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe — lue uniquement par la CLI Prisma en local pour les
# migrations (jamais au runtime, voir src/server/db/prisma.ts qui n'utilise
# que DATABASE_URL).
DIRECT_URL="postgresql://prisma:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Auth — Settings > API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
