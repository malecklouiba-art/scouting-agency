# PostgreSQL — Supabase Dashboard > Connect. Rôle "prisma" dédié (bypassrls),
# pas le rôle postgres par défaut — voir https://supabase.com/docs/guides/database/prisma.
#
# Connexion directe (pas le pooler Supavisor) : un rôle créé via SQL plutôt
# que via le Dashboard "Database roles" n'est pas forcément reconnu par le
# pooler ("tenant/user ... not found"). Le pooler (aws-0-[region].pooler.
# supabase.com, ports 6543/5432) reste préférable en production pour la
# mise à l'échelle, mais demande de créer le rôle via le Dashboard plutôt
# qu'en SQL brut si vous voulez l'utiliser.
DATABASE_URL="postgresql://prisma:[password]@db.[project-ref].supabase.co:5432/postgres"
DIRECT_URL="postgresql://prisma:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Auth — Settings > API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
